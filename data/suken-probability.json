  "lessons": [
    {
      "id": "count",
      "title": "順列と組合せ",
      "referencePages": [
        158,
        163
      ],
      "steps": [
        [
          "選んでから次を選ぶ",
          "シャツ3種類それぞれにズボン2種類を合わせると、組合せは3×2通りです。",
          "3×2=6通り",
          "重ならない別の場合をまとめるときは足し算。続く選択を組み合わせるときは掛け算です。"
        ],
        [
          "順番を区別して並べる",
          "異なるn個からr個を並べる順列はnPᵣ。1つ選ぶごとに残りが減ります。",
          "4P₂=4×3=12、4!=4×3×2×1=24",
          "!は階乗。n個全部を並べるとn!通りです。"
        ],
        [
          "順番を区別せず選ぶ",
          "A,BとB,Aを同じ選び方とするのが組合せ。並べ替えたr!通り分を割ります。",
          "4C₂=(4×3)/(2×1)=6",
          "nCᵣ=nPᵣ/r!。同じ物を繰り返し選ばない場合です。"
        ]
      ],
