  "lessons": [
    {
      "id": "distribute",
      "title": "かっこを開く：分配法則",
      "steps": [
        [
          "文字は数の入れ物",
          "3xは3×xの省略です。かっこの外の数を、中の各項に掛けます。",
          "3(x + 2) = 3×x + 3×2 = 3x + 6",
          "xに1を入れると、左右とも9になることを確かめよう。"
        ],
        [
          "引き算にも配る",
          "引かれる項にも、外の数を掛けます。",
          "2(x − 4) = 2x − 8",
          "最初の項だけに掛けて終わらないようにしよう。"
        ],
        [
          "外がマイナスのとき",
          "負の数を掛けるときも、1項ずつ符号を確認します。",
          "−2(x − 3) = −2x + 6",
          "−2×(−3)=+6。−(x−3)なら−1を配ります。"
        ]
      ],
      "questions": [
        {
          "id": "algebra-distribute-1",
          "stage": "guided",
          "text": "3(x + 4)を開く途中式は？",
