    {
      "id": "sets",
      "title": "集合・共通部分・和集合",
      "referencePages": [
        24,
        28
      ],
      "steps": [
        [
          "集まりをかっこで表す",
          "条件のはっきりした集まりを集合、入っている一つ一つを要素と呼びます。",
          "A={1,2,3}、B={3,4}",
          "集合の中では順番は関係なく、同じ要素は1回だけ書きます。"
        ],
        [
          "両方と、どちらか",
          "∩は共通部分。両方に入るものです。∪は和集合。少なくとも片方に入るものです。",
          "A∩B={3} ／ A∪B={1,2,3,4}",
          "和集合で3を2回数えないようにしよう。"
        ],
        [
          "全体から外す",
          "全体集合Uを決めると、Aに入らない要素全体がAの補集合になります。",
          "U={1,2,3,4,5}、A={1,2,3} → Aの補集合={4,5}",
          "何を全体とするかを先に確認します。"
        ]
      ],
