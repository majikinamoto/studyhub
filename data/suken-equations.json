  "lessons": [
    {
      "id": "zero",
      "title": "積が0になる方程式",
      "referencePages": [
        29,
        38
      ],
      "steps": [
        [
          "方程式の解とは",
          "式を成り立たせるxの値が解です。両辺に同じ数を足す・引く、0以外の同じ数で割る操作で探します。",
          "x+3=5 → x=2",
          "代入して左辺と右辺が等しくなるか確認しよう。"
        ],
        [
          "積が0なら",
          "2つの数の積が0なら、少なくとも一方は0です。",
          "(x−2)(x+3)=0 → x−2=0 または x+3=0",
          "x=2、−3の両方が解になります。"
        ],
        [
          "まず因数分解する",
          "2次式でも、積の形に直せば同じ考えで解けます。",
          "x²−5x+6=0 → (x−2)(x−3)=0 → x=2,3",
          "掛けて6、足して−5になる−2と−3を探します。"
        ]
      ],
      "questions": [
        {
          "id": "equations-zero-1",
          "stage": "guided",
          "text": "(x−4)(x+1)=0。x−4=0から得られる解は？",
          "hint": "両辺に4を足す。",
          "explanation": "x−4=0よりx=4。",
          "correctChoiceId": "equations-zero-1-0",
          "choices": [
