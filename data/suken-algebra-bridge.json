{
  "title": "展開・因数分解：基礎から1次の問題へ",
  "diagnostic": [
    {
      "text": "−3(x−2)を展開しよう。",
      "answer": "−3x+6",
      "lines": [
        "−3(x−2)=−3×x+(−3)×(−2)",
        "=−3x+6"
      ],
      "hint": "−3を両方の項に掛けます。",
      "check": [
        "両方の項に−3を掛けた",
        "負×負を正にできた"
      ],
      "label": "分配法則",
      "href": "./suken-algebra.html#view=lesson&unit=distribute"
    },
    {
      "text": "(x+2)(x−3)を展開しよう。",
      "answer": "x²−x−6",
      "lines": [
        "=x²−3x+2x−6",
        "=x²−x−6"
      ],
      "hint": "4つの積を書いてから同類項をまとめます。",
      "check": [
        "4つの積を漏れなく書いた",
        "−3x+2x=−xにできた"
      ],
      "label": "2つのかっこの掛け算",
      "href": "./suken-algebra.html#view=lesson&unit=expand"
    },
    {
      "text": "x²−9を因数分解しよう。",
      "answer": "(x+3)(x−3)",
      "lines": [
        "x²−9=x²−3²",
        "=(x+3)(x−3)"
      ],
      "hint": "「2乗−2乗」を探します。",
      "check": [
        "9を3²と見た",
        "展開すると元の式に戻る"
      ],
      "label": "平方差の公式",
      "href": "./suken-algebra.html"
    }
  ],
  "lessons": [
    {
      "id": "three-terms",
      "title": "3つの項の2乗",
      "source": "第1回・1次 問題1（p.60）",
      "base": "distribute",
      "steps": [
        {
          "title": "2乗は、同じかっこを掛けること",
          "body": "x²はx×xです。かっこ全体の2乗も、同じかっこを2回掛けます。中の各項だけを2乗すると、掛け合わせた項が抜けます。",
          "lines": [
            "(x+2−1)²",
            "=(x+2−1)(x+2−1)"
          ],
          "note": "x=1なら左辺は4。x²+2²+(−1)²では6になり、同じ値になりません。"
        },
        {
          "title": "9つの積を一つずつ書く",
          "body": "左のx、2、−1を、右の3つの項にそれぞれ掛けます。まず符号も含めて全て書こう。",
          "lines": [
            "x×x+x×2+x×(−1)",
            "+2×x+2×2+2×(−1)",
            "+(−1)×x+(−1)×2+(−1)×(−1)"
          ],
          "note": "xの項は2x−x+2x−x=2x。定数は4−2−2+1=1なので、答えはx²+2x+1です。"
        },
        {
          "title": "同じ積は2回出てくる",
          "body": "a,b,cは、数でも文字の式でもよい入れ物です。abとbaは等しいので、まとめると2abになります。",
          "lines": [
            "(a+b+c)²",
            "=a²+b²+c²",
            "+2ab+2bc+2ca"
          ],
          "note": "cが負なら、その符号ごと代入します。公式が不安なら9つの積に戻ろう。"
        },
        {
          "title": "文字の式でも同じ手順",
          "body": "(x²+x−2)²ならa=x²、b=x、c=−2と考えます。指数は掛け算で足します。",
          "lines": [
            "a²=x⁴、b²=x²、c²=4",
            "2ab=2x³、2bc=−4x、2ca=−4x²",
            "答え：x⁴+2x³−3x²−4x+4"
          ],
          "note": "x²の項をx²−4x²=−3x²とまとめます。x=0を入れると左右とも4ですが、1つの代入だけでは式全体の正しさの証明にはなりません。"
        }
      ],
      "questions": [
        {
          "text": "(x²+x−2)²で、a=x²、b=x、c=−2。2caは？",
          "answer": "−4x²",
          "lines": [
            "2ca=2×(−2)×x²",
            "=−4x²"
          ],
          "hint": "cの負の符号も掛けます。",
          "check": [
            "−2を符号ごと使った",
            "x²の指数を変えなかった"
          ]
        },
        {
          "text": "(x²+x−2)²で出るx²−4x²をまとめよう。",
          "answer": "−3x²",
          "lines": [
            "x²−4x²=(1−4)x²",
            "=−3x²"
          ],
          "hint": "係数1と−4を足します。",
          "check": [
            "同じx²の項だけをまとめた"
          ]
        },
        {
          "text": "(x²+2x−1)²を展開しよう。",
          "answer": "x⁴+4x³+2x²−4x+1",
          "lines": [
            "=x⁴+4x²+1+4x³−4x−2x²",
            "=x⁴+4x³+2x²−4x+1"
          ],
          "hint": "a=x²、b=2x、c=−1。6つの項を計算。",
          "check": [
            "(2x)²=4x²にした",
            "交差する3組の積を2倍した",
            "4x²−2x²をまとめた"
          ]
        },
        {
          "text": "(2x²−x−1)²を展開しよう。",
          "answer": "4x⁴−4x³−3x²+2x+1",
          "lines": [
            "=4x⁴+x²+1−4x³+2x−4x²",
            "=4x⁴−4x³−3x²+2x+1"
          ],
          "hint": "b=−x、c=−1の積は正。",
          "check": [
            "(2x²)²=4x⁴にした",
            "2×(−x)×(−1)=2xにした",
            "x²−4x²をまとめた"
          ]
        },
        {
          "text": "(x²+x−3)²を展開しよう。",
          "answer": "x⁴+2x³−5x²−6x+9",
          "lines": [
            "=x⁴+x²+9+2x³−6x−6x²",
            "=x⁴+2x³−5x²−6x+9"
          ],
          "hint": "−3を一つの項として扱います。",
          "check": [
            "(−3)²=9にした",
            "x²−6x²=−5x²にした"
          ]
        }
      ]
    },
    {
      "id": "grouped-square",
      "title": "まとまりを一つの文字と見る",
      "source": "第1回・1次 問題2（p.61）",
      "base": "factor",
      "steps": [
        {
          "title": "まず共通の形を探す",
          "body": "4y²−4yz+z²は、2yとzの2乗と積からできています。",
          "lines": [
            "(2y−z)²",
            "=(2y)²−2×2y×z+z²",
            "=4y²−4yz+z²"
          ],
          "note": "真ん中の符号と係数が一致するか確かめます。"
        },
        {
          "title": "引くかっこは符号に注意",
          "body": "9x²−4y²+4yz−z²の後半を、かっこにまとめます。",
          "lines": [
            "9x²−(4y²−4yz+z²)",
            "=(3x)²−(2y−z)²"
          ],
          "note": "かっこの前に−があるので、内側の−4yzは、開くと+4yzです。"
        },
        {
          "title": "平方差をまとまりに使う",
          "body": "A=3x、B=2y−zと見れば、A²−B²=(A+B)(A−B)です。",
          "lines": [
            "(3x+(2y−z))(3x−(2y−z))",
            "=(3x+2y−z)(3x−2y+z)"
          ],
          "note": "最後の−(2y−z)は−2y+z。内側の符号を両方変えます。"
        }
      ],
      "questions": [
        {
          "text": "4y²−4yz+z²を、かっこの2乗にしよう。",
          "answer": "(2y−z)²",
          "lines": [
            "(2y−z)²=4y²−4yz+z²"
          ],
          "hint": "(A−B)²=A²−2AB+B²。",
          "check": [
            "真ん中の−4yzまで一致する"
          ]
        },
        {
          "text": "−(2y−z)のかっこを開こう。",
          "answer": "−2y+z",
          "lines": [
            "−(2y−z)=−1×2y+(−1)×(−z)"
          ],
          "hint": "−1を両方に掛けます。",
          "check": [
            "zの符号を正に変えた"
          ]
        },
        {
          "text": "4x²−y²+2yz−z²を因数分解しよう。",
          "answer": "(2x+y−z)(2x−y+z)",
          "lines": [
            "=4x²−(y²−2yz+z²)",
            "=(2x)²−(y−z)²",
            "=(2x+y−z)(2x−y+z)"
          ],
          "hint": "後半を(y−z)²としてまとめます。",
          "check": [
            "引くかっこの符号が合っている",
            "平方差を使った"
          ]
        },
        {
          "text": "x²−4y²−4yz−z²を因数分解しよう。",
          "answer": "(x+2y+z)(x−2y−z)",
          "lines": [
            "=x²−(4y²+4yz+z²)",
            "=x²−(2y+z)²",
            "=(x+2y+z)(x−2y−z)"
          ],
          "hint": "今度は(2y+z)²です。",
          "check": [
            "+4yzを含む2乗を見つけた",
            "引く側は−2y−zにした"
          ]
        },
        {
          "text": "16x²−9y²+6yz−z²を因数分解しよう。",
          "answer": "(4x+3y−z)(4x−3y+z)",
          "lines": [
            "=(4x)²−(9y²−6yz+z²)",
            "=(4x)²−(3y−z)²",
            "=(4x+3y−z)(4x−3y+z)"
          ],
          "hint": "16x²=(4x)²。",
          "check": [
            "3y−zの2乗を確かめた",
            "引く側のzが正になった"
          ]
        }
      ]
    },
    {
      "id": "repeat-difference",
      "title": "平方差を繰り返す",
      "source": "第3回・1次 問題1（p.117）、第5回・1次 問題1（p.178）",
      "base": "multiply",
      "steps": [
        {
          "title": "計算しやすい組を選ぶ",
          "body": "掛け算は順番を変えられます。同じ形の足し算と引き算を先に組にすると、途中の式が短くなります。",
          "lines": [
            "(x−1)(x+1)(x²+1)",
            "=(x²−1)(x²+1)"
          ],
          "note": "最初の2つに(A−B)(A+B)=A²−B²を使いました。"
        },
        {
          "title": "できた式にも同じ公式",
          "body": "x²を一つのまとまりAと見ます。もう一度平方差です。",
          "lines": [
            "(x²−1)(x²+1)",
            "=(x²)²−1²",
            "=x⁴−1"
          ],
          "note": "(x²)²=x⁴。x²×x²なので指数2+2=4です。"
        },
        {
          "title": "差を逆向きに見て因数分解",
          "body": "展開の逆もできます。x⁴−16ならx²と4の平方差を見つけます。",
          "lines": [
            "x⁴−16=(x²−4)(x²+4)",
            "=(x−2)(x+2)(x²+4)"
          ],
          "note": "実数の係数で因数分解するとき、x²+4を(x−2)(x+2)にはできません。その積はx²−4です。"
        }
      ],
      "questions": [
        {
          "text": "(x−2)(x+2)を展開しよう。",
          "answer": "x²−4",
          "lines": [
            "=(x)²−2²",
            "=x²−4"
          ],
          "hint": "和と差の積を探そう。",
          "check": [
            "定数項が−4になった"
          ]
        },
        {
          "text": "(x²−4)(x²+4)で、(x²)²はいくつ？",
          "answer": "x⁴",
          "lines": [
            "(x²)²=x²×x²",
            "=x⁴"
          ],
          "hint": "同じ底の掛け算は指数を足します。",
          "check": [
            "x²を2倍する意味と区別した"
          ]
        },
        {
          "text": "(x−2)(x+2)(x²+4)を展開しよう。",
          "answer": "x⁴−16",
          "lines": [
            "=(x²−4)(x²+4)",
            "=x⁴−16"
          ],
          "hint": "平方差を2回使えます。",
          "check": [
            "組を選んで計算した",
            "4²=16にした"
          ]
        },
        {
          "text": "x⁴−81を実数の係数で因数分解しよう。",
          "answer": "(x−3)(x+3)(x²+9)",
          "lines": [
            "=(x²−9)(x²+9)",
            "=(x−3)(x+3)(x²+9)"
          ],
          "hint": "81=9²、9=3²です。",
          "check": [
            "平方差を2回使った",
            "x²+9をそのまま残した"
          ]
        },
        {
          "text": "(a−b)(a+b)(a²+b²)を展開しよう。",
          "answer": "a⁴−b⁴",
          "lines": [
            "=(a²−b²)(a²+b²)",
            "=a⁴−b⁴"
          ],
          "hint": "文字が2種類でも同じ公式です。",
          "check": [
            "a²とb²をまとまりと見た"
          ]
        }
      ]
    },
    {
      "id": "two-letters",
      "title": "2種類の文字の因数分解",
      "source": "第3回・1次 問題2（p.118）",
      "base": "factor",
      "steps": [
        {
          "title": "一つの文字について整理する",
          "body": "x²+xy−2y²+3x+2を、xの2次式と見ます。yは消さずに、係数の中に置きます。",
          "lines": [
            "x²+(y+3)x+(−2y²+2)"
          ],
          "note": "xy+3x=(y+3)xです。まず、xの項と、xを含まない項を分けます。"
        },
        {
          "title": "簡単な例で和と積を探す",
          "body": "x²+xy−2y²なら、(x+A)(x+B)でA+B=y、AB=−2y²になるA,Bを探します。",
          "lines": [
            "A=2y、B=−y",
            "(x+2y)(x−y)",
            "=x²+xy−2y²"
          ],
          "note": "数字の因数分解の「和と積」と同じ。展開してxの係数も確かめます。"
        },
        {
          "title": "定数も含むかっこを探す",
          "body": "xを含まない−2y²+2を因数分解すると、かっこの候補が見つかります。",
          "lines": [
            "−2y²+2=−2(y²−1)",
            "=−2(y+1)(y−1)",
            "=(2y+2)(−y+1)"
          ],
          "note": "A=2y+2、B=−y+1なら、A+B=y+3も一致します。"
        },
        {
          "title": "全ての項を確かめる",
          "body": "和と積が両方合ったら、xを入れたかっこに戻します。最後に展開して検算します。",
          "lines": [
            "x²+(y+3)x−2y²+2",
            "=(x+2y+2)(x−y+1)"
          ],
          "note": "A+B=y+3、AB=−2y²+2。元の式の各項と一致しました。"
        }
      ],
      "questions": [
        {
          "text": "xy+3xを、xでくくろう。",
          "answer": "(y+3)x",
          "lines": [
            "xy+3x=x(y+3)"
          ],
          "hint": "共通の因数xを外へ。",
          "check": [
            "xyのyを残した"
          ]
        },
        {
          "text": "A=2y、B=−yのときA+BとABは？",
          "answer": "和y、積−2y²",
          "lines": [
            "A+B=2y−y=y",
            "AB=2y×(−y)=−2y²"
          ],
          "hint": "和と積の両方を確認。",
          "check": [
            "積の符号を負にした"
          ]
        },
        {
          "text": "x²+xy−2y²を因数分解しよう。",
          "answer": "(x+2y)(x−y)",
          "lines": [
            "2y+(−y)=y、2y×(−y)=−2y²",
            "(x+2y)(x−y)=x²+xy−2y²"
          ],
          "hint": "和y、積−2y²になる組。",
          "check": [
            "和と積を確かめた"
          ]
        },
        {
          "text": "x²+xy−2y²+3x+2を因数分解しよう。",
          "answer": "(x+2y+2)(x−y+1)",
          "lines": [
            "A=2y+2、B=−y+1",
            "A+B=y+3、AB=−2y²+2",
            "=(x+2y+2)(x−y+1)"
          ],
          "hint": "かっこの定数も含めて展開してみよう。",
          "check": [
            "xの係数y+3が合う",
            "定数部分−2y²+2が合う"
          ]
        },
        {
          "text": "x²+xy−2y²+4x−y+3を因数分解しよう。",
          "answer": "(x+2y+3)(x−y+1)",
          "lines": [
            "−2y²−y+3=(2y+3)(−y+1)",
            "A=2y+3、B=−y+1",
            "A+B=y+4、AB=−2y²−y+3"
          ],
          "hint": "xを含まない部分を因数分解し、和も確かめます。",
          "check": [
            "元の式と全ての項を照合した"
          ]
        }
      ]
    }
  ]
}
