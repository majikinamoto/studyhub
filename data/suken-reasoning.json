  "lessons": [
    {
      "id": "proof",
      "title": "等式・不等式を証明する",
      "referencePages": [
        19,
        23
      ],
      "steps": [
        [
          "例を調べるだけでは証明にならない",
          "x=1や2で成り立っても、すべてのxで成り立つとは限りません。文字のまま変形します。",
          "(x+1)²−(x−1)²=4x",
          "左辺を展開し、同じ項を打ち消して右辺にします。"
        ],
        [
          "不等式は差の符号を見る",
          "左辺≥右辺を示すには、左辺−右辺が0以上と示せば十分です。",
          "a²+b²−2ab=(a−b)²≥0",
          "実数の2乗は0以上。この事実が理由になります。"
        ],
        [
          "等号はいつ成り立つ？",
          "差が0になる条件を調べます。",
          "(a−b)²=0 ⇔ a=b",
          "証明は「変形」と「その式が0以上である理由」の両方を書こう。"
        ]
      ],
      "questions": [
        {
          "id": "reasoning-proof-1",
          "stage": "guided",
          "text": "(x+1)²の展開は？",
          "hint": "真ん中は2×x×1。",
          "explanation": "x²+x+x+1=x²+2x+1。",
          "correctChoiceId": "reasoning-proof-1-0",
          "choices": [
            {
              "text": "x²+2x+1",
              "feedback": "正解です。解説の途中式も確認しよう。",
              "id": "reasoning-proof-1-0"
            },
            {
              "text": "x²+1",
              "feedback": "途中式を見直そう。真ん中は2×x×1。",
              "id": "reasoning-proof-1-1"
            },
            {
              "text": "x²+x+1",
              "feedback": "途中式を見直そう。真ん中は2×x×1。",
              "id": "reasoning-proof-1-2"
            },
            {
              "text": "x²+2x−1",
              "feedback": "途中式を見直そう。真ん中は2×x×1。",
