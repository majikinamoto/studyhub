    {
      "id": "recurrence",
      "title": "漸化式から一般項へ",
      "referencePages": [
        131,
        136
      ],
      "steps": [
        [
          "隣の項の関係で決める",
          "aₙ₊₁は第n+1項。漸化式と初項を決めると、数列を順番に作れます。",
          "a₁=1、aₙ₊₁=2aₙ+1 → 1,3,7,15,…",
          "何番目の項を計算しているかを書いて確認しよう。"
        ],
        [
          "定数を移して等比数列にする",
          "両辺に1を足すと、かっこの中が同じ形になります。",
          "aₙ₊₁+1=2(aₙ+1)",
          "bₙ=aₙ+1と置けばbₙ₊₁=2bₙ。公比2の等比数列です。"
        ],
        [
          "元の文字へ戻す",
          "初項b₁=a₁+1=2なのでbₙ=2×2ⁿ⁻¹=2ⁿです。",
          "aₙ=bₙ−1=2ⁿ−1",
          "n=1で1、n=2で3となることを元の漸化式と比べます。"
        ]
      ],
